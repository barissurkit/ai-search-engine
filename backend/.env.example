APP_NAME=AI Search Engine API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
TAVILY_API_KEY=your_tavily_api_key
TAVILY_BASE_URL=https://api.tavily.com
OPENAI_API_KEY=your_openai_api_key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_GENERATION_MODEL=gpt-5.6-terra
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Optional for a remote Ollama-compatible endpoint; leave empty for local Ollama.
OLLAMA_API_KEY=
OLLAMA_GENERATION_MODEL=qwen3:4b-instruct
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_EMBEDDING_DIMENSIONS=768
OLLAMA_REQUEST_TIMEOUT_SECONDS=120.0
RAG_RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_MULTIPLIER=3
RETRIEVAL_MAX_CHUNKS_PER_SOURCE=1
QDRANT_URL=http://localhost:6333
# Optional for managed/remote Qdrant; leave empty for local Docker Qdrant.
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ai_search_chunks
# Comma-separated browser origins allowed to call this API. Leave empty for local Vite proxy.
CORS_ALLOWED_ORIGINS=
WEB_FETCH_TIMEOUT_SECONDS=10.0
WEB_FETCH_USER_AGENT=AI-Search-Engine/0.1
WEB_INGESTION_MAX_CONCURRENCY=3
